/target
# Conformance proto files are fetched from the tools image.
conformance/protos/
conformance/target-nostd/

# Cargo build artefacts
target/
benchmarks/results/
benchmarks/charts/__pycache__/
benchmarks/datasets/hyperpb/

# Stress test output
stress/googleapis/out/
.task/

# fuzz testing corpus
fuzz/corpus/

# Local tooling extracted from the tools image (task install-protoc).
/.local/

# Local editor settings
/.claude/settings.local.json

# IDEs
.idea/

# buffa-build's protoc dot-path test creates its fixture inside the crate
# directory, because it needs paths relative to the working directory. An
# interrupted run leaves the directory behind.
/buffa-build/.tmp*/
